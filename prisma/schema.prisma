// T-Shoot Knowledge Base — data model
// Configured for Postgres (e.g. Supabase's free tier). DATABASE_URL should
// be Supabase's pooled ("Transaction" mode, port 6543) connection string;
// DIRECT_URL should be the direct (port 5432) connection string, used only
// for running migrations. See README.md for exact steps.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// NOTE: these fields are plain Strings rather than Prisma `enum` blocks so
// the schema also works unmodified on SQLite for local dev without a
// database at all. Postgres (used in production here) does support real
// enums if you want the extra DB-level constraint later — optional, not
// required. Allowed values are enforced by zod at the API boundary
// (src/lib/validation.ts) and typed as string-literal unions at the app
// layer (src/lib/types.ts).
//
// Role:          GLOBAL_ADMIN | SENIOR_TECHNICIAN | MID_TECHNICIAN | INTERN | VIEWER
// ArticleStatus: DRAFT | IN_REVIEW | PUBLISHED | ARCHIVED
// Visibility:    PUBLIC_TO_TEAM | TECHNICIANS_ONLY | SENIOR_TECH_ONLY | ADMIN_ONLY | PRIVATE | SENSITIVE
// ArticleType:   SOP | TROUBLESHOOTING | QUICK_FIX | COMMAND | CHECKLIST | KNOWN_ISSUE
// StepType:      TEXT | COMMAND | WARNING | NOTE | SCREENSHOT | CHECKPOINT | DECISION | LINK

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          String    @default("VIEWER")
  disabled      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  articles      Article[]        @relation("ArticleAuthor")
  versions      ArticleVersion[]
  comments      Comment[]
  favorites     Favorite[]
  auditLogs     AuditLog[]
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  articles    Article[]
}

model Tag {
  id       String        @id @default(cuid())
  name     String        @unique
  articles ArticleTag[]
}

model Article {
  id                    String        @id @default(cuid())
  title                 String
  description           String
  type                  String        @default("SOP")
  categoryId            String?
  category              Category?     @relation(fields: [categoryId], references: [id])
  status                String        @default("DRAFT")
  visibility            String        @default("PUBLIC_TO_TEAM")
  priority              String?       // e.g. Low/Medium/High/Critical
  difficulty            String?       // e.g. Beginner/Intermediate/Advanced
  audience              String?       // free text, e.g. "All technicians"
  estimatedTime         String?       // e.g. "10 minutes"
  requiredAccessLevel   String?       // free-text note distinct from `visibility` enum
  internalNotes         String?       // never shown outside GLOBAL_ADMIN / author
  isDemo                Boolean       @default(false)

  authorId              String
  author                User          @relation("ArticleAuthor", fields: [authorId], references: [id])

  currentVersion        Int           @default(1)

  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  publishedAt           DateTime?

  steps                 Step[]
  tags                  ArticleTag[]
  versions              ArticleVersion[]
  comments              Comment[]
  attachments           Attachment[]
  favorites             Favorite[]

  relatedFrom           RelatedArticle[] @relation("RelatedFrom")
  relatedTo             RelatedArticle[] @relation("RelatedTo")

  @@index([status])
  @@index([visibility])
  @@index([categoryId])
}

model RelatedArticle {
  id            String   @id @default(cuid())
  fromArticleId String
  toArticleId   String
  fromArticle   Article  @relation("RelatedFrom", fields: [fromArticleId], references: [id], onDelete: Cascade)
  toArticle     Article  @relation("RelatedTo", fields: [toArticleId], references: [id], onDelete: Cascade)

  @@unique([fromArticleId, toArticleId])
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
}

model Step {
  id             String    @id @default(cuid())
  articleId      String
  article        Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  order          Int
  type           String    @default("TEXT")
  title          String?
  content        String?   // narrative/instruction text
  command        String?   // for COMMAND type
  shell          String?   // PowerShell / CMD / Bash / SQL / etc
  expectedResult String?
  warning        String?
  notes          String?
  linkUrl        String?   // for LINK type
  linkLabel      String?
  // Simple decision-tree support (kept minimal per spec section 4)
  decisionYesStepOrder Int?
  decisionNoStepOrder  Int?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  attachments    Attachment[]

  @@index([articleId, order])
}

// Full immutable snapshot of an article + its steps at the moment a
// meaningful change was saved. Never deleted by normal editing.
model ArticleVersion {
  id             String   @id @default(cuid())
  articleId      String
  article        Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  versionNumber  Int
  snapshot       String   // JSON-serialized article + steps at this point
  changeSummary  String?
  createdById    String
  createdBy      User     @relation(fields: [createdById], references: [id])
  createdAt      DateTime @default(now())

  @@unique([articleId, versionNumber])
}

model Comment {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Attachment {
  id         String   @id @default(cuid())
  articleId  String
  article    Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  stepId     String?
  step       Step?    @relation(fields: [stepId], references: [id], onDelete: Cascade)
  filename   String
  path       String   // relative path under /public/uploads
  caption    String?
  mimeType   String
  size       Int
  createdAt  DateTime @default(now())
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, articleId])
}

// Immutable log of significant actions across the system.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String   // e.g. "ARTICLE_CREATED", "ARTICLE_PUBLISHED", "LOGIN"
  targetType String?  // e.g. "Article", "User", "Category"
  targetId   String?
  details    String?  // free-text / JSON summary, never secrets
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
