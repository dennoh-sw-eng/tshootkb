# ── Database (Supabase Postgres) ──────────────────────────────────────────
# From Supabase dashboard: Project Settings → Database → Connection string
# DATABASE_URL = the pooled "Transaction" mode string (port 6543) — used at runtime
# DIRECT_URL   = the direct connection string (port 5432) — used only for migrations
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# ── NextAuth ───────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# ── Supabase Storage (attachments) ─────────────────────────────────────────
# From Supabase dashboard: Project Settings → API
SUPABASE_URL="https://xxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"   # server-only secret, never expose to the browser
SUPABASE_STORAGE_BUCKET="attachments"

MAX_UPLOAD_SIZE_MB=10
